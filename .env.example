# --- Model gateway (OpenAI-compatible Chat Completions API) ---
# Required for dashboard generation and AI metadata drafting.
OPENAI_API_KEY=
# Leave empty for api.openai.com, or point at your gateway, e.g. https://gateway.example.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
# Leave empty to omit temperature (some reasoning models reject it).
OPENAI_TEMPERATURE=0.1
# Optional JSON object of extra headers your gateway needs, e.g. {"x-team": "bi"}
OPENAI_DEFAULT_HEADERS=
OPENAI_TIMEOUT_SECONDS=120

# --- Application ---
# State database (dashboards, metadata, history). Defaults to backend/data/app.db.
# APP_DB_URL=sqlite:////absolute/path/app.db
DEMO_ENABLED=true

# --- Execution bounds ---
DEFAULT_ROW_LIMIT=500
MAX_ROW_LIMIT=5000
QUERY_TIMEOUT_SECONDS=15
RESULT_CACHE_TTL_SECONDS=120
